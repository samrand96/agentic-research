# .env.example: a CHECKLIST of the environment variables this project can use.
# It contains NO real values and is safe to share.
#
# Do NOT put real keys in this file or in any file inside the project.
# Save them as environment variables instead. Step by step: setup-guides/08-api-keys.md
#   Windows (PowerShell):  setx NAME "value"      then reopen the terminal and the apps
#   macOS:                 add  export NAME="value"  to ~/.zshrc   (Linux: ~/.bashrc)
#
# paper-search plug-in (https://github.com/openags/paper-search-mcp)
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=           # needed for Unpaywall: an email address you choose
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=  # recommended, free: semanticscholar.org/product/api
PAPER_SEARCH_MCP_CORE_API_KEY=              # recommended, free: core.ac.uk/services/api
PAPER_SEARCH_MCP_OPENALEX_API_KEY=          # optional, free: openalex.org/signup
PAPER_SEARCH_MCP_OPENALEX_EMAIL=            # optional
PAPER_SEARCH_MCP_WOS_API_KEY=               # optional: Web of Science Starter API (developer.clarivate.com)
PAPER_SEARCH_MCP_SCOPUS_API_KEY=            # optional: dev.elsevier.com, needs your university's subscription
PAPER_SEARCH_MCP_IEEE_API_KEY=              # optional: developer.ieee.org, IEEE customers only
#
# Zotero plug-in (https://github.com/54yyyu/zotero-mcp): local mode needs no key
ZOTERO_LOCAL=true
